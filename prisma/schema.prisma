// 1. Prisma Client를 생성하기 위한 설정
generator client {
  provider = "prisma-client-js"
}

// 2. 데이터베이스 연결 설정 (PostgreSQL)
datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

//유저 모델
model User {
  id           Int      @id @default(autoincrement())
  email        String?  @unique
  password     String? // 암호화된 비밀번호
  nickname     String   @unique
  profileImage String? // 프로필 사진 URL
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  googleId     String?  @unique
  provider     String   @default("LOCAL")

  posts    Post[]
  comments Comment[]
}

// 3. 게시글 모델 (설계도)
model Post {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(50)
  content   String   @db.Text
  nickname  String?  @db.VarChar(8)
  password  String?
  view      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 🔥 추가: 역정규화를 위한 댓글 카운트 컬럼
  commentCount Int @default(0)

  // 추가: 이 게시글에 달린 댓글들 (1:N 관계)
  comments Comment[]
  images   Image[] // 🔥 추가: 게시글에 포함된 이미지들
  hasImage Boolean   @default(false) // 게시글에 이미지 있는지 없는지 확인
  // [추가] 회원과 연결 (선택사항 ? 를 붙여서 익명글일 땐 비워둠)
  authorId Int?
  author   User?     @relation(fields: [authorId], references: [id])
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  nickname  String
  password  String?
  createdAt DateTime @default(now())

  isDeleted Boolean   @default(false) // 삭제 여부 상태값
  deletedAt DateTime? // 삭제된 시점 (선택 사항이지만 관리용으로 좋음)

  // 추가: 어느 게시글의 댓글인지 연결
  postId   Int
  post     Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  author   User? @relation(fields: [authorId], references: [id])
  authorId Int?
}

model Image {
  id        Int      @id @default(autoincrement())
  url       String // 이미지 접근 주소 (예: /uploads/abc.jpg)
  filename  String // 저장된 파일명 (서버 관리용)
  createdAt DateTime @default(now())

  // 어느 게시글에 포함된 이미지인지 연결
  postId Int
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
}
